# 環境変数のサンプル（ローカルの Next.js と、本番の .env.prod のキーを含む）。
#
# - ローカル: このファイルをコピーしてルートに .env を作る（./setup.sh が作る）。Next.js が
#   自動で読み込む。「本番のみ」の節は空のままでよい（ローカルでは使われない）。
#   Go API のローカル用の環境変数は、別に server/.env.example から server/.env を作る
# - 本番: このファイルをコピーして、Lightsail Instance 上に .env.prod を作り、「本番のみ」の
#   節の値を設定する。`docker compose --env-file .env.prod -f docker-compose.prod.yml ...` で
#   読み込み、docker-compose.prod.yml が web・api 等の各コンテナに渡す
#
# .env・.env.prod は git の管理外（.gitignore）。値の入ったファイルをコミットしないこと。

# =============================================================================
# ローカル（Next.js）
# =============================================================================

# Next.js が参照する Go API のベース URL。`go run ./cmd/api` のデフォルトポートに合わせる。
# 本番では使われない（docker-compose.prod.yml が DOMAIN から組み立ててビルド時に渡す）
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# =============================================================================
# 本番のみ（.env.prod）
# =============================================================================

# 公開ドメイン。Caddy の証明書の取得・Next.js のビルド（NEXT_PUBLIC_API_BASE_URL）・
# Go API の CORS（ALLOWED_ORIGIN）に使う。GitHub Secrets の DOMAIN と同じ値にする。
# 例: example.com、IP ベースなら 1.2.3.4.sslip.io
DOMAIN=

# 本番の MySQL コンテナのパスワード（root と、アプリ用ユーザー app）。
# Go API の DATABASE_URL は docker-compose.prod.yml が MYSQL_PASSWORD から組み立てる
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# 以下は Go API に渡す。各キーの意味は server/.env.example を参照
# /api/books/sync の認可に使うベアラートークン（本番では必ず設定する）
CRON_SECRET=
# 公開デモを読み取り専用にする場合に true（POST/PUT/PATCH/DELETE を 403 で拒否）
READ_ONLY=
# 問い合わせフォームの送信に使う SMTP 設定（AWS SES の SMTP インターフェースを想定）
CONTACT_SMTP_HOST=
CONTACT_SMTP_PORT=
CONTACT_SMTP_USERNAME=
CONTACT_SMTP_PASSWORD=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
