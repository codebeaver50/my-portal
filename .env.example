# 環境変数のサンプル（ローカル開発・本番の両方のキーを含む）。
#
# - ローカル: このファイルをコピーしてルートに .env を作る（./setup.sh が作る）。
#   Next.js は .env を自動で読み込む。Go API は自動で読み込まないため（godotenv 等は未導入）、
#   `set -a; source .env; set +a` してから `go run` する（README.md を参照）
# - 本番: このファイルをコピーして、Lightsail Instance 上に .env.prod を作る。
#   `docker compose --env-file .env.prod -f docker-compose.prod.yml ...` で読み込む
#
# .env・.env.prod は git の管理外（.gitignore）。値の入ったファイルをコミットしないこと。
# 値に括弧等を含む場合は、bash でも source できるよう "..." で囲む。

# =============================================================================
# 共通（ローカル・本番）
# =============================================================================

# GET/POST /api/books/sync の認可に使うベアラートークン。
# 本番では、cron実行元（サーバー上のcron等）から `Authorization: Bearer <値>` を付けて
# 呼び出す。API は公開URLで待ち受けるため、本番では必ず設定すること。
# 未設定の場合は認可チェック自体をスキップする（ローカル開発用の挙動）。
CRON_SECRET=

# true/1 にすると、GET/HEAD/OPTIONS 以外の全リクエスト（POST/PUT/PATCH/DELETE）を 403 で
# 拒否する読み取り専用モード。公開デモでシードデータを書き換えられたくない場合に本番でのみ
# 設定する。未設定時は通常どおり書き込みを許可する。
# ただし /api/books/sync（cron専用、CRON_SECRET で保護）・ログイン/ログアウト・SimpleCMS の
# 記事/カテゴリの作成/更新/削除（アクセス管理の simple-cms の write 権限で保護）・
# /api/contact（DB を変更せずメール転送するのみ）は、READ_ONLY が有効でも許可される
# （server/cmd/api/main.go の readOnlyMiddleware の除外リスト）。
READ_ONLY=

# Contact ページの問い合わせフォーム（server/internal/contact）が送信に使う SMTP 設定。
# 本番は AWS SES の SMTP インターフェースを想定。6つとも設定されていないと送信は常に失敗する。
#   CONTACT_SMTP_HOST: 例 email-smtp.ap-northeast-1.amazonaws.com
#   CONTACT_SMTP_PORT: 例 587
#   CONTACT_SMTP_USERNAME / CONTACT_SMTP_PASSWORD: SES の SMTP 認証情報
#     （IAM のアクセスキーそのものではなく、SES コンソールで発行する SMTP 専用のもの）
#   CONTACT_FROM_EMAIL: SES で検証済みの送信元アドレス
#   CONTACT_TO_EMAIL: 問い合わせを転送したい受信先アドレス
#
# ローカルでは、docker-compose.yml の mailpit コンテナ（実際には送信せず、
# http://localhost:8025 で内容を確認できる SMTP キャッチャー）を使う。./setup.sh で作る .env
# には次の値が入る:
#   CONTACT_SMTP_HOST=localhost
#   CONTACT_SMTP_PORT=1025
#   CONTACT_SMTP_USERNAME=contact
#   CONTACT_SMTP_PASSWORD=contact
#   CONTACT_FROM_EMAIL=no-reply@example.com
#   CONTACT_TO_EMAIL=test@example.com
CONTACT_SMTP_HOST=
CONTACT_SMTP_PORT=
CONTACT_SMTP_USERNAME=
CONTACT_SMTP_PASSWORD=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=

# =============================================================================
# ローカルのみ（本番では docker-compose.prod.yml が DOMAIN・MYSQL_PASSWORD から組み立てるため、
# .env.prod に残っていても使われない）
# =============================================================================

# Next.js が参照する Go API のベース URL。`go run ./cmd/api` のデフォルトポートに合わせる
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# MySQL の接続文字列。docker-compose.yml の値に合わせる
DATABASE_URL="mysql://app:app@tcp(127.0.0.1:3306)/my_portal"

# Go API（Gin）のリッスンポート（未設定時は 8080）。Next.js の開発サーバーのポートには
# 影響しない（Next.js は .env の PORT を読まない）
PORT=8080

# Go API が CORS で許可するフロントのオリジン（未設定時は http://localhost:3000）
ALLOWED_ORIGIN=http://localhost:3000

# =============================================================================
# 本番のみ（.env.prod）
# =============================================================================

# 公開ドメイン。Caddy の証明書の取得・Next.js のビルド（NEXT_PUBLIC_API_BASE_URL）・
# Go API の CORS（ALLOWED_ORIGIN）に使う。GitHub Secrets の DOMAIN と同じ値にする。
# 例: example.com、IP ベースなら 1.2.3.4.sslip.io
DOMAIN=

# 本番の MySQL コンテナのパスワード（root と、アプリ用ユーザー app）
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
