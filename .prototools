# このプロジェクトで使うツールのバージョン（proto: https://moonrepo.dev/proto）。
# `proto install` で、ここに書いたツールがまとめて入る。
# node は .nvmrc（CI はこちらを読む）と揃える（CI で確認している）。.nvmrc だけにすると、
# 下の detect-strategy により、グローバル（~/.proto/.prototools）や親ディレクトリの
# .prototools で固定した node が .nvmrc より優先されてしまうため、ここにも書く。
# go は server/go.mod の go ディレクティブと揃える（CI で確認している）。
node = "24"
go = "1.25.4"
golangci-lint = "2.14.0"

[settings]
# server/ では go.mod の go ディレクティブ（proto は「1.25.4以上」として扱う）より、
# ここで固定したバージョンを優先する
detect-strategy = "prefer-prototools"

[plugins]
golangci-lint = "file://./.proto/plugins/golangci-lint.toml"
