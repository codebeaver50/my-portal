# Go API（server/）が読む環境変数。
# Goプロセスはこのファイルを自動読み込みしない（godotenv等は未導入）。
# ローカルで使う場合は各自シェルでexportするか、`server/.env` を作って
# `set -a; source server/.env; set +a` してから `go run` すること。

# MySQL接続文字列。ローカルはdocker-compose.ymlの値に合わせる
DATABASE_URL=mysql://app:app@tcp(127.0.0.1:3306)/my_portal

# Ginサーバーのリッスンポート（未設定時は8080）
PORT=8080

# CORSで許可するフロントのオリジン（未設定時は http://localhost:3000）
ALLOWED_ORIGIN=http://localhost:3000

# GET/POST /api/books/sync の認可に使うベアラートークン。
# APIは公開URLで待ち受けるため、本番では必ず設定すること。
# 未設定の場合は認可チェック自体をスキップする（ローカル開発用の挙動）。
# cron実行元（サーバー上のcron等）から `Authorization: Bearer <値>` を
# 付けて呼び出すよう設定する。
CRON_SECRET=

# ポートフォリオ共通の管理者ログインパスワード（internal/admin）。
# POST /api/admin/login で照合し、一致すれば署名付きセッションCookieを発行
# する。このCookieを持つリクエストのみ、各featureのadmin.AuthMiddlewareで
# 保護された書き込み系エンドポイント（例: SimpleCMSの記事・カテゴリの作成/更新/
# 削除）が使える。未設定の場合、管理者ログインは常に失敗する
#（＝管理者専用の書き込み系エンドポイントは誰も使えない）。
ADMIN_PASSWORD=

# true/1 にすると、GET/HEAD/OPTIONS以外の全リクエスト（POST/PUT/PATCH/DELETE）を
# 403で拒否する読み取り専用モード。公開デモ環境でシードデータを書き換えられたく
# ない場合に本番でのみ設定する。未設定時は通常どおり書き込みを許可する。
# ただし /api/books/sync（cron専用バッチ更新、CRON_SECRETで保護）と
# 管理者ログイン（/api/admin/login, /api/admin/logout）・SimpleCMSの記事/
# カテゴリの作成/更新/削除（admin.AuthMiddlewareで管理者セッションを別途
# 要求）は、READ_ONLYが有効でも常に許可される（cmd/api/main.go の
# readOnlyMiddleware 呼び出しで除外指定）。
READ_ONLY=

# Contactページの問い合わせフォーム（internal/contact）が送信に使うSMTP設定
# （AWS SESのSMTPインターフェースを想定）。6つとも設定されていないと送信は
# 常に失敗する（ローカルでは未設定のままでよく、その場合フォーム送信は
# 500エラーになる）。
# CONTACT_SMTP_HOST: 例 email-smtp.ap-northeast-1.amazonaws.com
# CONTACT_SMTP_PORT: 例 587
# CONTACT_SMTP_USERNAME / CONTACT_SMTP_PASSWORD: SESのSMTP認証情報
#   （IAMのアクセスキーそのものではなく、SESコンソールで発行するSMTP専用の
#   ユーザー名・パスワード）
# CONTACT_FROM_EMAIL: SESで検証済みの送信元アドレス
# CONTACT_TO_EMAIL: 問い合わせを転送したい受信先アドレス
CONTACT_SMTP_HOST=
CONTACT_SMTP_PORT=
CONTACT_SMTP_USERNAME=
CONTACT_SMTP_PASSWORD=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
